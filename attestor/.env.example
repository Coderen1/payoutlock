# Ed25519 signing key ONLY — never submits a transaction itself (Bölüm 6).
ATTESTOR_SECRET=

# Separate Stellar account — submits submit_attestation, pays fees, never signs attestations.
RELAYER_SECRET=

# Phase 3 only: script/CLI SEP-10 signing for the demo User — NOT the final web UX
# (real UI will sign via Wallets Kit/Freighter, Bölüm 7/9 of the implementation plan).
USER_SECRET=
GUARANTEE_PROVIDER_SECRET=

ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# Phase 4 only: Demo Off-Ramp Simulator identities. Separate from every role
# above; only ever used by DEMO_MODE=true scenario scripts (demoOffRampSimulator.ts
# refuses to run at all unless DEMO_MODE=true). Never the same key as
# ATTESTOR_SECRET/RELAYER_SECRET/USER_SECRET/GUARANTEE_PROVIDER_SECRET.
DEMO_OFFRAMP_SECRET=
DEMO_REFUND_SECRET=
